# Manual remote standby.  Copy to the ignored semantic_model_remote.env and
# fill the actual endpoint/key only on the host allowed to use that provider.
# Select it explicitly per run; the default .env remains local-only.
SEMANTIC_MODEL_MODE=http
SEMANTIC_MODEL_ENDPOINT=https://REMOTE_MODEL_HOST/v1
SEMANTIC_MODEL_NAME=REMOTE_MODEL_NAME
SEMANTIC_MODEL_PROTOCOL=openai_chat
SEMANTIC_MODEL_API_KEY_ENV=SEMANTIC_MODEL_REMOTE_API_KEY
SEMANTIC_MODEL_REMOTE_API_KEY=replace-me-locally
SEMANTIC_MODEL_REASONING_EFFORT=off
