<?xml version="1.0"?>
<launch>
  <arg name="config_file" default="$(find physical_nav)/config/physical_nav.yaml"/>
  <arg name="model_path" default="/home/user/ldl/molmospaces/detection_models/yoloe/weights/yoloe-26l-seg-pf.pt"/>
  <arg name="device" default="cuda:0"/>
  <!-- Normal standing Go2 base_link height is 0.305 m; camera ground height 1.285 m => relative z 0.980 m. -->
  <arg name="camera_x" default="0.03"/><arg name="camera_y" default="0.0"/><arg name="camera_z" default="0.98"/>
  <!-- Camera points 8 degrees forward/down; RPY values are radians. -->
  <arg name="camera_roll" default="0.0"/><arg name="camera_pitch" default="0.1396263"/><arg name="camera_yaw" default="0.0"/>
  <arg name="sensor_ws_url" default="ws://127.0.0.1:12335"/>
  <arg name="web_url" default="http://127.0.0.1:8765"/>
  <arg name="web_state_enabled" default="true"/>
  <arg name="ros_python" default="/usr/bin/python3"/>
  <arg name="system_ros_python" default="/home/user/ldl/molmospaces/scripts/InteractiveNav/physical_nav/physical_ros_python.sh"/>
  <arg name="start_mapping" default="true"/>
  <arg name="semantic_override_config" default="$(find physical_nav)/config/semantic_shadow_override.yaml"/>
  <arg name="explore_override_config" default="$(find physical_nav)/config/explore_physical_override.yaml"/>
  <arg name="move_base_override_config" default="$(find physical_nav)/config/physical_move_base_override.yaml"/>
  <arg name="interaction_profile" default="physical_human"/>
  <arg name="enable_m1" default="true"/>
  <arg name="enable_interaction_policy" default="true"/>

  <!-- Existing nodes are reused through physical topic parameters.  No
       simulator launch or default semantic_mapping config is modified. -->
  <node name="semantic_mapping_py" pkg="semantic_mapping_py_pkg" type="semantic_mapping_node.py" launch-prefix="$(arg ros_python)" output="screen" respawn="false">
    <rosparam file="$(arg config_file)" command="load"/>
    <rosparam file="$(arg semantic_override_config)" command="load"/>
    <param name="semantic_map/subscribe_pointcloud" value="true" type="bool"/>
  </node>
  <!-- Module 1 was previously absent from the physical launch, so detected
       portals entered the graph but never received a visual state patch. -->
  <node if="$(arg enable_m1)" name="interaction_attribute_inference" pkg="semantic_mapping_py_pkg" type="interaction_attribute_inference_node.py" launch-prefix="$(arg ros_python)" output="screen" respawn="false">
    <rosparam file="$(arg config_file)" command="load"/>
    <rosparam file="$(arg semantic_override_config)" command="load"/>
    <param name="model_name" value="qwen3.6-35b-a3b-fp8"/>
    <!-- 256 tokens frequently truncates M1's JSON before the closing
         interaction_parts/action_regions fields.  Keep the response small,
         but leave enough room for a valid structured result. -->
    <param name="max_output_tokens" value="384"/>
    <param name="request_timeout_s" value="20.0"/>
    <param name="min_interval_s" value="2.0"/>
    <!-- Generic locker/safe tracks that M1 calls refrigerator receive one
         independent recheck; stop after two confirmations to avoid a permanent
         GPU refresh loop. -->
    <param name="m1_recheck_refresh_interval_s" value="2.0"/>
    <!-- Keep M1's admission vocabulary identical to the physical interaction
         candidate whitelist: only door and fridge objects may trigger VLM
         attribute analysis. -->
    <rosparam param="include_keywords">[door, fridge, refrigerator, locker]</rosparam>
    <!-- Physical M1 consumes the 3-D ObjectMap's stable tracked detections;
         the raw mapper topic remains unchanged. Thin door masks commonly
         occupy 5-15% of their 2-D rectangle, so use a physical-only gate. -->
    <param name="topics/object_detections" value="/physical_nav/tracked_detections"/>
    <param name="min_visible_fraction" value="0.04"/>
    <param name="min_visible_pixels" value="1024"/>
    <param name="min_bbox_area_px" value="1600"/>
    <param name="max_distance_m" value="8.0"/>
    <!-- A one-frame RGB-D box is not sufficient for an interaction object.
         Require two consecutive observations before M1 sees the track. -->
    <param name="required_consecutive_observations" value="2"/>
    <param name="worker_count" value="1"/>
    <param name="max_queue_size" value="8"/>
  </node>
  <group>
    <remap from="/registered_scan" to="/physical_nav/points"/>
    <remap from="/struct_mapping/occ_map" to="/physical_nav/occupancy"/>
    <remap from="/struct_mapping/occ_map_updates" to="/physical_nav/occupancy_updates"/>
    <remap from="/filtered_pointcloud" to="/physical_nav/filtered_pointcloud"/>
    <remap from="/odom" to="/physical_nav/odom"/>
    <!-- Instantiate the stock mapping nodes here so physical-only timing
         overrides do not change the simulator launch/configuration. -->
    <node pkg="struct_mapping_pkg" type="slam_gmapping" name="slam_gmapping" output="screen">
      <rosparam command="load" file="$(find struct_mapping_pkg)/config/slam_gmapping_params.yaml"/>
      <param name="use_odom_pose_for_mapping" value="true"/>
      <param name="mapping_scan_source" value="pointcloud"/>
      <param name="mapping_scan_topic" value="/physical_nav/points"/>
      <!-- Do not wait for a future TF transform.  The point cloud is already
           stamped with the camera capture time and the mapper has its own
           nearest-odom guard below; a positive MessageFilter tolerance adds
           avoidable latency to every frame. -->
      <param name="scan_filter_tolerance_sec" value="0.0"/>
      <!-- D435i and Go2 telemetry arrive over independent WebSocket packets.
           Their measured nearest-stamp delta is commonly 70-150 ms, so the
           simulation-tuned 30 ms guard discarded most physical scans. -->
      <param name="max_odom_cloud_time_diff" value="0.15"/>
      <!-- Conservative D435i planar projection for the physical OCC map:
           reject floor/ceiling returns and isolated angular hits while
           retaining supported door/furniture surfaces. -->
      <param name="maxUrange" value="7.9"/>
      <param name="pointcloud_scan_range_max" value="8.0"/>
      <param name="pointcloud_scan_height_min" value="0.12"/>
      <param name="pointcloud_scan_height_max" value="1.60"/>
      <param name="pointcloud_scan_min_points_per_beam" value="4"/>
      <param name="pointcloud_scan_cluster_min_points" value="8"/>
      <!-- Per-beam point/cluster checks already reject sparse depth noise.
           Requiring additional angular neighbours discarded valid clear rays
           beside depth discontinuities and left unknown seams in OCC. -->
      <param name="pointcloud_scan_min_support_neighbors" value="0"/>
      <!-- Re-enable the mapper's existing observed-ray overwrite layer for
           the physical platform. Supported no-return rays clear cells in the
           camera-observed range; unobserved directions remain untouched. -->
      <param name="enable_local_overwrite" value="true"/>
      <param name="local_overwrite_radius" value="7.9"/>
      <param name="local_overwrite_mark_occupied" value="true"/>
      <param name="local_overwrite_clear_confirm_count" value="1"/>
      <param name="local_overwrite_occupy_confirm_count" value="2"/>
      <param name="local_overwrite_ttl_sec" value="2.0"/>
      <param name="local_overwrite_clear_static_occupied" value="true"/>
    </node>
    <node pkg="struct_mapping_pkg" type="voronoi_mapping_node" name="voronoi_mapping" respawn="false">
      <rosparam command="load" file="$(find struct_mapping_pkg)/config/voronoi_params.yaml"/>
    </node>
  </group>
  <node name="physical_ros_gateway" pkg="physical_nav" type="physical_ros_gateway.py" launch-prefix="$(arg ros_python)" output="screen" respawn="false">
    <rosparam file="$(arg config_file)" command="load"/>
    <param name="web_url" value="$(arg web_url)"/>
    <param name="legacy_http_sensor" value="false" type="bool"/>
    <param name="legacy_http_state" value="false" type="bool"/>
    <param name="web_state_enabled" value="$(arg web_state_enabled)" type="bool"/>
    <!-- The camera source is 10 Hz. Polling faster only repeats HTTP/JPEG/
         depth work and competes with the dashboard for the same gateway. -->
    <param name="rate" value="10.0"/>
    <!-- Room topology changes slowly; forward its large grid at 2 Hz while
         the raw OCC path remains at the higher visualization rate. -->
    <param name="room_grid_period" value="0.5"/>
    <param name="world_frame" value="tf_frame_map"/>
    <param name="camera_frame" value="d435i_color_optical_frame"/>
    <param name="camera_parent" value="tf_frame_base_link"/>
    <!-- Keep reliable obstacle endpoints within 8 m. Finite depth estimates
         beyond that horizon retain only their bearing as a clear-only point
         just outside obstacle_range; zero/invalid depth remains absent. -->
    <param name="point_stride" value="6"/>
    <param name="max_depth_m" value="8.0"/>
    <param name="no_return_depth_m" value="8.05"/>
    <param name="occupancy_grid_topic" value="/physical_nav/occupancy"/>
    <param name="room_grid_topic" value="/physical_nav/room_segment_grid"/>
    <param name="global_costmap_topic" value="/move_base/global_costmap/costmap"/>
    <param name="local_costmap_topic" value="/move_base/local_costmap/costmap"/>
    <param name="camera_x" value="$(arg camera_x)"/><param name="camera_y" value="$(arg camera_y)"/><param name="camera_z" value="$(arg camera_z)"/>
    <param name="camera_roll" value="$(arg camera_roll)"/><param name="camera_pitch" value="$(arg camera_pitch)"/><param name="camera_yaw" value="$(arg camera_yaw)"/>
  </node>

  <!-- The direct WebSocket bridge needs the websockets package from the
       algorithm environment. It still uses rospy, like the gateway below;
       system_ros_python intentionally remains reserved for ROS-only nodes. -->
  <node name="physical_sensor_ros_bridge" pkg="physical_nav" type="physical_sensor_ros_bridge.py" launch-prefix="$(arg ros_python)" output="screen" respawn="true" respawn_delay="1.0">
    <param name="url" value="$(arg sensor_ws_url)"/>
    <param name="web_url" value="$(arg web_url)"/>
    <param name="web_mirror_enabled" value="$(arg web_state_enabled)" type="bool"/>
    <param name="camera_frame" value="d435i_color_optical_frame"/><param name="camera_parent" value="tf_frame_base_link"/>
    <param name="camera_x" value="$(arg camera_x)"/><param name="camera_y" value="$(arg camera_y)"/><param name="camera_z" value="$(arg camera_z)"/>
    <param name="camera_roll" value="$(arg camera_roll)"/><param name="camera_pitch" value="$(arg camera_pitch)"/><param name="camera_yaw" value="$(arg camera_yaw)"/>
    <param name="point_stride" value="6"/><param name="max_depth_m" value="8.0"/><param name="no_return_depth_m" value="8.05"/>
  </node>

  <!-- This adapter only needs rospy/tf2 and must use ROS Noetic's system
       Python.  Under the Conda 3.11 interpreter rospy.init_node spins before
       registration, consuming one full CPU core and never publishing. -->
  <node name="physical_nav_consistency" pkg="physical_nav" type="physical_consistency_node.py" launch-prefix="$(arg system_ros_python)" output="screen">
    <param name="evaluation_rate_hz" value="1.0"/>
    <param name="camera_frame" value="d435i_color_optical_frame"/>
    <param name="world_frame" value="tf_frame_map"/>
    <param name="camera_x" value="$(arg camera_x)"/><param name="camera_y" value="$(arg camera_y)"/><param name="camera_z" value="$(arg camera_z)"/>
    <param name="camera_roll" value="$(arg camera_roll)"/><param name="camera_pitch" value="$(arg camera_pitch)"/><param name="camera_yaw" value="$(arg camera_yaw)"/>
  </node>
  <!-- Physical-only safety output. The read-only launch deliberately leaves
       this topic unconsumed; an armed control bridge may subscribe later. -->
  <node name="physical_velocity_safety" pkg="physical_nav" type="physical_velocity_safety.py" launch-prefix="/usr/bin/python3" output="screen" respawn="false">
    <rosparam file="$(arg config_file)" command="load"/>
    <param name="input_topic" value="/physical_nav/shadow_cmd_vel"/>
    <param name="output_topic" value="/physical_nav/actuated_cmd_vel"/>
  </node>
  <!-- Single writer for the physical shadow command.  move_base and the
       semantic executor are separate sources; never let ROS interleave their
       Twist messages on one topic. -->
  <node name="physical_velocity_command_mux" pkg="physical_nav" type="velocity_command_mux.py" launch-prefix="/usr/bin/python3" output="screen" respawn="true" respawn_delay="1.0">
    <param name="move_base_topic" value="/physical_nav/move_base_cmd_vel"/>
    <param name="semantic_topic" value="/physical_nav/semantic_cmd_vel"/>
    <param name="output_topic" value="/physical_nav/shadow_cmd_vel"/>
    <param name="publish_rate_hz" value="20.0"/>
    <param name="move_base_timeout_s" value="0.35"/>
    <param name="semantic_timeout_s" value="0.40"/>
    <param name="semantic_stop_hold_s" value="0.35"/>
  </node>
  <!-- Idle until semantic_behavior_executor emits an interaction command. -->
  <!-- rospy from ROS Noetic must run under the system ROS Python here. The
       Conda 3.11 interpreter can import rospy but spins forever in init_node,
       leaving speech and M3 topics silently unregistered. -->
  <node if="$(arg enable_interaction_policy)" name="physical_interaction_policy" pkg="physical_nav" type="physical_interaction_policy_node.py" launch-prefix="$(arg system_ros_python)" output="screen" respawn="true" respawn_delay="1.0">
    <rosparam file="$(arg config_file)" command="load"/>
    <param name="profile" value="$(arg interaction_profile)"/>
    <param name="qwen_base_url" value="http://127.0.0.1:18080/v1"/>
    <param name="qwen_model" value="qwen3.6-35b-a3b-fp8"/>
  </node>
  <!-- Publish real global/local costmaps while keeping every navigation output
       in an unconsumed shadow namespace. The local obstacle layer consumes
       the latest filtered D435i cloud rather than a copy of the SLAM map. -->
  <group>
    <!-- move_base's odometry helper is private to this include.  Without this
         remap it subscribes to the unused global /odom name, keeps a stale
         velocity stamp, and eventually makes the local planner fail TF
         lookups after the first gateway restart. -->
    <remap from="/odom" to="/physical_nav/odom"/>
    <remap from="/registered_scan" to="/physical_nav/points"/>
    <remap from="/filtered_pointcloud" to="/physical_nav/filtered_pointcloud"/>
    <include file="$(find nav_pkg)/launch/nav.launch">
      <arg name="global_map_topic" value="/physical_nav/occupancy"/>
      <arg name="cmd_vel_topic" value="/physical_nav/move_base_cmd_vel"/>
      <arg name="cmd_vel_stamped_topic" value="/physical_nav/shadow_cmd_vel_stamped"/>
      <arg name="move_base_respawn" value="true"/>
      <arg name="override_config_file" value="$(arg move_base_override_config)"/>
    </include>
  </group>
  <!-- Full navigation/interaction decision chain in shadow mode. The local
       move_base action server remains connected to planners, but every final
       velocity output is remapped to an unconsumed physical_nav sink. -->
  <group>
    <remap from="/odom" to="/physical_nav/odom"/>
    <remap from="/struct_mapping/occ_map" to="/physical_nav/occupancy"/>
    <remap from="/semantic_mapping/unified_graph" to="/physical_nav/unified_graph"/>
    <!-- ExplorePy is an external-control observer on the physical lane.  Its
         reset/stop callbacks must not compete with move_base or the semantic
         executor on the real command bus. -->
    <remap from="/cmd_vel" to="/physical_nav/explore_cmd_vel"/>
    <remap from="/cmd_vel_stamped" to="/physical_nav/shadow_cmd_vel_stamped"/>
    <remap from="/move_base_simple/goal" to="/physical_nav/shadow_goal"/>
    <include file="$(find explore_py_pkg)/launch/explore_py.launch">
      <arg name="external_control_enabled" value="true"/>
      <arg name="override_config_file" value="$(arg explore_override_config)"/>
    </include>
  </group>
  <group>
    <remap from="/odom" to="/physical_nav/odom"/>
    <remap from="/struct_mapping/occ_map" to="/physical_nav/occupancy"/>
    <remap from="/semantic_mapping/unified_graph" to="/physical_nav/unified_graph"/>
    <remap from="/semantic_mapping/interaction_result" to="/physical_nav/interaction_result"/>
    <remap from="/semantic_mapping/attribute_updates" to="/physical_nav/attribute_updates"/>
    <remap from="/semantic_mapping/attribute_refresh_requests" to="/physical_nav/attribute_refresh_requests"/>
    <remap from="/semantic_decision/interaction_command" to="/physical_nav/interaction_command"/>
    <remap from="/cmd_vel" to="/physical_nav/semantic_cmd_vel"/>
    <remap from="/cmd_vel_stamped" to="/physical_nav/shadow_cmd_vel_stamped"/>
    <include file="$(find semantic_decision_py_pkg)/launch/semantic_decision.launch">
      <arg name="override_config_file" value="$(arg semantic_override_config)"/>
    </include>
  </group>
  <!-- The gateway is started separately so it can run before roslaunch and
       accept the Go2 WebSocket connection. -->
</launch>
