# Default to the local OpenAI-compatible Qwen service.  Copy this file to the
# ignored .env and change only host-local values when necessary.
SEMANTIC_MODEL_MODE=http
SEMANTIC_MODEL_ENDPOINT=http://127.0.0.1:8000/v1
SEMANTIC_MODEL_NAME=qwen3.6-35b-a3b-fp8
SEMANTIC_MODEL_PROTOCOL=openai_chat
SEMANTIC_MODEL_API_KEY_ENV=SEMANTIC_MODEL_LOCAL_API_KEY
SEMANTIC_MODEL_LOCAL_API_KEY=local
SEMANTIC_MODEL_REASONING_EFFORT=off

# The runner owns SEMANTIC_MODEL_METRICS_PATH and its call timeout.  Keep the
# remote standby in semantic_model_remote.env (ignored); see the companion
# semantic_model_remote.env.example template.

# Optional local alternatives:
# SEMANTIC_MODEL_MODE=command
# SEMANTIC_MODEL_COMMAND=python /absolute/path/to/selector.py
# SEMANTIC_MODEL_REASONING_EFFORT=low
# SEMANTIC_MODEL_IMAGE_DETAIL=low
# SEMANTIC_MODEL_TEMPERATURE=0
