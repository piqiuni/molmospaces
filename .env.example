# Copy this file to .env and fill in the endpoint/API key used by the decision node.
# Never commit the copied .env or a real API key.
SEMANTIC_MODEL_MODE=http
SEMANTIC_MODEL_ENDPOINT=https://example.invalid/v1/interactive-navigation
SEMANTIC_MODEL_NAME=qwen3.6-35b-a3b
SEMANTIC_MODEL_PROTOCOL=openai_chat
SEMANTIC_MODEL_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=replace-me-locally
SEMANTIC_MODEL_METRICS_PATH=
SEMANTIC_MODEL_REASONING_EFFORT=off

# Optional alternatives:
# SEMANTIC_MODEL_MODE=command
# SEMANTIC_MODEL_COMMAND=python /absolute/path/to/selector.py
# SEMANTIC_MODEL_TIMEOUT_S=20
# Keep online decision calls bounded; reasoning models may consume part of this budget.
# SEMANTIC_MODEL_MAX_TOKENS=384
# Use a reasoning-capable model only after explicitly changing this setting.
# SEMANTIC_MODEL_REASONING_EFFORT=low
# SEMANTIC_MODEL_IMAGE_DETAIL=low
# SEMANTIC_MODEL_TEMPERATURE=0
