<launch>
  <!-- 配置文件参数（如果单独启动此launch文件时使用） -->
  <arg name="config_file" default="$(find semantic_mapping_pkg)/config/default.yaml"/>
  <arg name="scene_type_mapping_file" default="$(find semantic_mapping_pkg)/config/scene_type_mapping.yaml"/>
  <arg name="blip_mode" default="client" doc="BLIP节点模式: client（客户端版本）或 mock（模拟版本）"/>
  
  <!-- 加载配置文件（仅在单独启动此launch文件时加载） -->
  <!-- 注意：如果通过unified_system.launch启动，配置文件已在父launch中统一加载，这里不会重复加载 -->
  <rosparam file="$(arg config_file)" command="load"/>
  
  <!-- 加载场景类型映射配置 -->
  <rosparam file="$(arg scene_type_mapping_file)" command="load"/>
  
  <!-- 语义建图节点（物体建图 + 场景建图） -->
  <node name="semantic_mapping_node" pkg="semantic_mapping_pkg" type="semantic_mapping_node" respawn="true">
  </node>

  <include file="$(find semantic_mapping_pkg)/launch/blip_node.launch">
    <arg name="blip_mode" value="$(arg blip_mode)"/>
  </include>
  
  <include file="$(find semantic_mapping_pkg)/launch/scene_to_14channel.launch">
  </include>

</launch>
